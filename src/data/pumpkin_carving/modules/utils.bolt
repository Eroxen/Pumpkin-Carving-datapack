def measure_text_width(string):
    width = 0
    for char in string:
        width += char_width[char] + 1
    return width

def text_padding(width):
    spaces = width // 6
    zws = width - (spaces * 6)
    chars = [" \u200c"] * spaces + ["\u200c"] * zws
    return {"text":"".join(chars), "bold":True}