from beet import Language, FunctionTag
from nbtlib import Float

class Translations:
  def error(key, text):
    return {"translate":"key","fallback":text,"color":"red"}
  
def add_translation(key: str, value: str):
    lang = ctx.assets.languages.get("pumpkin_carving:en_us", {data:{}}).data
    lang[key] = value
    ctx.assets.languages["pumpkin_carving:en_us"] = Language(lang)
    return key

def register_scoreboard_objective(name):
    append function pumpkin_carving:uninstall/remove_scoreboard_objectives:
      scoreboard objectives remove name
    return name

def add_to_function_tag(tag_location):
    func = ~/
    ctx.data.function_tags.setdefault(tag_location).merge(FunctionTag({
        "values": [
            func
        ]
    }))

def camel_case_to_snake_case(s: str):
    out = s[0].lower()
    for c in s[1:]:
        if c.isupper():
            out += '_' + c.lower()
        elif c.islower() or c.isnumeric():
            out += c
        else:
            out += '_'
    while '__' in out:
        out = out.replace('__','_')
    return out

def snake_case_to_words(s: str):
    words = []
    for word in s.split("_"):
        words.append(word.capitalize())
    return " ".join(words)


